    {
      "parameters": {
        "jsCode": "// Normalize + validate the outgoing email payload before sending.\nconst body = ($json.body && typeof $json.body === 'object') ? $json.body : ($json || {});\nconst str = (v) => (v === undefined || v === null) ? '' : String(v).trim();\n\nconst leadId = str(body.leadId);\nconst recipient = str(body.recipient);\nconst subject = str(body.subject);\nconst emailBody = str(body.body);\nconst attachments = Array.isArray(body.attachments) ? body.attachments : [];\n\nconst emailRe = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nlet _valid = true;\nlet _error = '';\n\nif (!leadId) { _valid = false; _error = 'leadId is required.'; }\nelse if (!recipient) { _valid = false; _error = 'Recipient email is required.'; }\nelse if (!emailRe.test(recipient)) { _valid = false; _error = 'Recipient is not a valid email address.'; }\nelse if (!subject) { _valid = false; _error = 'Subject cannot be empty.'; }\nelse if (!emailBody) { _valid = false; _error = 'Email body cannot be empty.'; }\n\n// Build the return item\nconst item = {\n  json: {\n    leadId,\n    recipient,\n    subject,\n    body: emailBody,\n    _valid,\n    _error\n  }\n};\n\n// If attachments are provided, attach all of them\nif (_valid && attachments.length > 0) {\n  item.binary = {};\n  attachments.forEach((file, index) => {\n    if (file && file.base64) {\n      const base64Clean = file.base64.replace(/^data:.*?;base64,/, '');\n      const key = `attachment_${index + 1}`;\n      item.binary[key] = {\n        data: base64Clean,\n        mimeType: file.type || 'application/pdf',\n        fileName: file.name || `document_${index + 1}.pdf`,\n      };\n    }\n  });\n}\n\nreturn [item];\n"
      },
