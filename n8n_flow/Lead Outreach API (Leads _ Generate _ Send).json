    {
      "parameters": {
        "jsCode": "// Normalize + validate the incoming lead payload.\nconst body = ($json.body && typeof $json.body === 'object') ? $json.body : ($json || {});\nconst str = (v) => (v === undefined || v === null) ? '' : String(v).trim();\nconst lead = {\n  leadId: str(body.leadId),\n  name: str(body.name),\n  company: str(body.company),\n  role: str(body.role),\n  email: str(body.email),\n  linkedinUrl: str(body.linkedinUrl),\n  postUrl: str(body.postUrl),\n  postContent: str(body.postContent),\n  jobTitle: str(body.jobTitle),\n  location: str(body.location),\n};\nlet _valid = true;\nlet _error = '';\nif (!lead.leadId) { _valid = false; _error = 'leadId is required.'; }\nelse if (!lead.name && !lead.company && !lead.postContent) {\n  _valid = false; _error = 'At least one of name, company or postContent is required to generate an email.';\n}\nreturn [{ json: { ...lead, _valid, _error } }];"
      },
