    {
      "parameters": {
        "jsCode": "// Map Supabase leads to the frontend-friendly shape.\n// Supabase uses snake_case column names.\n// Missing/null values become \"\" except email, which becomes null.\n\nconst rows = $input.all().filter(\n  i => i.json && Object.keys(i.json).length > 0\n);\n\nconst str = (v) => {\n  if (v === undefined || v === null) return '';\n  return String(v).trim();\n};\n\nconst data = [];\n\nfor (const it of rows) {\n  const r = it.json || {};\n\n  const postUrl = str(r.post_url);\n\n  // Use Supabase ID as the lead ID.\n  const leadId = r.id != null\n    ? String(r.id)\n    : postUrl || str(r.poster_profile_url) || `lead-${data.length + 1}`;\n\n  data.push({\n    leadId,\n\n    name: str(r.poster_name),\n\n    company: str(r.company),\n\n    role: str(r.poster_title),\n\n    email: r.email == null || str(r.email) === ''\n      ? null\n      : str(r.email),\n\n    linkedinUrl: str(r.poster_profile_url),\n\n    postUrl,\n\n    postContent: str(r.post_content),\n\n    // We removed Posted At, so don't use it.\n    // date_added is Supabase's automatic creation timestamp.\n    postedAt: r.date_added\n      ? str(r.date_added)\n      : '',\n\n    location: str(r.job_location),\n\n    companyWebsite: str(r.company_url),\n\n    jobTitle: str(r.job_title),\n\n    source: 'LinkedIn',\n  });\n}\n\nreturn [\n  {\n    json: {\n      success: true,\n      data\n    }\n  }\n];"
      },
